# ─── Runtime mode ─────────────────────────────────────────────────
# Local development should run with dry-run + SQLite so `pnpm --filter
# @caliber/services dev` starts without production/testnet dependencies.
#
# For a real Casper testnet deployment, change this to `testnet` and fill the
# required deployment overrides near the bottom of this file.
CALIBER_ENV=development

# ─── Casper network ───────────────────────────────────────────────
# Public testnet RPC. Swap for your own node or a CSPR.cloud endpoint.
CASPER_NODE_RPC_URL=https://node.testnet.casper.network/rpc
CASPER_NETWORK_NAME=casper-test
# Deployed CaliberVault contract package hash. Required when CALIBER_DRY_RUN=false.
CALIBER_VAULT_CONTRACT_HASH=
# Agent signing key path. Required when CALIBER_DRY_RUN=false. NEVER commit the key.
CASPER_SECRET_KEY_PATH=
# Signing algorithm: ed25519 (default) or secp256k1.
CALIBER_KEY_ALGO=ed25519
# Payment (motes) for the record_rebalance call. Tune after the first deploy.
CALIBER_PAYMENT_MOTES=2500000000

# ─── Agent loop ───────────────────────────────────────────────────
# Local dev uses dry-run. Testnet/production must set this to false.
CALIBER_DRY_RUN=true
# How often the scheduler runs the loop, in milliseconds.
CALIBER_LOOP_INTERVAL_MS=60000

# ─── Persistence ──────────────────────────────────────────────────
# Local dev (default): SQLite file at this path.
CALIBER_SQLITE_PATH=./data/caliber.dev.sqlite
# Production: set a Postgres URL and it takes precedence over SQLite.
# CALIBER_DATABASE_URL=postgres://user:pass@host:5432/caliber
# Force in-memory (no durability), e.g. for CI: CALIBER_DB=memory

# ─── HTTP API (consumed by the web dashboard) ─────────────────────
CALIBER_API_PORT=4000
CALIBER_CORS_ORIGIN=http://localhost:3000
# Required for POST /runs and POST /approve in testnet/production.
CALIBER_ADMIN_TOKEN=

# ─── AI (model-agnostic via the Vercel AI SDK) ────────────────────
# Provider: 'anthropic' (default) or 'openrouter'. The provider selects which
# key is used and a default model. Leave the key empty to use the deterministic
# offline fallback (no LLM).
CALIBER_LLM_PROVIDER=anthropic

# anthropic: Claude directly.
ANTHROPIC_API_KEY=

# openrouter: one key across many providers + automatic provider fallbacks.
#   CALIBER_LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
#   CALIBER_DECISION_MODEL=openai/gpt-4o-mini   # pin a model; do NOT use auto-routing
OPENROUTER_API_KEY=

# Override the model for the active provider (default: claude-opus-4-8 for
# anthropic, openai/gpt-4o-mini for openrouter).
CALIBER_DECISION_MODEL=

# Independent Risk-Officer reviews per rebalance (majority veto). 3 is safer but
# 3x the review cost/latency; set 1 for a cheaper demo.
CALIBER_REVIEW_VOTES=3

# ─── Casper MCP Server (optional, for on-chain reads) ─────────────
# SSE URL of a running Casper MCP server. When required=false, the agent still
# uses the built-in Casper RPC toolkit tool and SDK fallback if this is unset.
CALIBER_CASPER_MCP_URL=
# Set true for buildathon/testnet runs where external Casper MCP must be connected.
CALIBER_CASPER_MCP_REQUIRED=false

# ─── Treasury policy ──────────────────────────────────────────────
# Testnet defaults to ./config/testnet-policy.json. Production must provide one
# of these explicitly. Development falls back to src/samplePolicy.ts when empty.
CALIBER_POLICY_PATH=
# Prefer CALIBER_POLICY_PATH on Railway; large JSON env values are easy to paste
# incompletely. Leave CALIBER_POLICY_JSON unset unless you really need it.
# CALIBER_POLICY_JSON={"id":"pol_testnet","name":"...","version":1,...}

# ─── External market / RWA data sources ───────────────────────────
# Testnet/production must provide a live feed returning Signal[] or
# { "signals": Signal[] }. Development may leave this empty, but manual/scheduled
# runs will fail until a feed is configured.
CALIBER_SIGNAL_FEED_URL=
CALIBER_SIGNAL_FEED_TIMEOUT_MS=10000
# Maximum age for any accepted signal observation. Default: 5 minutes.
CALIBER_SIGNAL_MAX_AGE_MS=300000
MARKET_DATA_API_KEY=

# ─── Testnet deployment checklist ─────────────────────────────────
# For Railway/testnet, override the local defaults above with:
#
# CALIBER_ENV=testnet
# CALIBER_DRY_RUN=false
# CALIBER_VAULT_CONTRACT_HASH=<deployed-contract-package-hash>
# CASPER_SECRET_KEY_PATH=<mounted-secret-key-path>
# CALIBER_KEY_ALGO=ed25519
# CALIBER_DATABASE_URL=postgres://user:pass@host:5432/caliber
# CALIBER_ADMIN_TOKEN=<strong-random-token>
# CALIBER_POLICY_PATH=./config/testnet-policy.json
# CALIBER_SIGNAL_FEED_URL=https://<your-live-signal-feed>/signals
#
# Optional, if you require an external Casper MCP server:
# CALIBER_CASPER_MCP_REQUIRED=true
# CALIBER_CASPER_MCP_URL=https://<your-casper-mcp-server>/sse
